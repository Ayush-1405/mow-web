# Mood of Wood — Staff Pilot
# Copy this file to .env and fill in real values. Vite loads .env
# automatically. Restart `npm run dev` after any change.
# Only names that start with VITE_ are sent to the browser. Never prefix a
# secret (service role, database password) with VITE_.
#
# Deploying? See .env.production for the production VITE_APP_ORIGIN
# override and the Supabase Edge Function secret it depends on.

# ---------------------------------------------------------------------------
# Frontend (required) — used by src/lib/supabase.js
# Copy from Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project ref (same as the subdomain of VITE_SUPABASE_URL)
VITE_SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# Local app origin — must match an origin allowed by the staff-* Edge Functions
# ---------------------------------------------------------------------------
VITE_APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Edge Function secrets (Supabase Dashboard -> Edge Functions -> Secrets)
# These are NOT used by the Vite app. They are listed here so one file holds
# the full config. Do not add VITE_ in front of them.
# Auto-injected on the server (do not paste the service role key here):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=
STAFF_INTERNAL_EMAIL_DOMAIN=
STAFF_SIGNED_URL_TTL_SECONDS=120
