# Mood of Wood — Staff Pilot — frontend
# Copy this file to .env and fill in real values. Vite loads .env
# automatically. Restart `npm run dev` after any change.
# Only names that start with VITE_ are sent to the browser. Never prefix a
# secret (service role, database password) with VITE_.
#
# Backend (Supabase Edge Function) config lives in ../supabase/.env.example
# — that includes ALLOWED_ORIGINS and the production deployment note it
# depends on.

# ---------------------------------------------------------------------------
# Frontend (required) — used by src/lib/supabase.js
# Copy from Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project ref (same as the subdomain of VITE_SUPABASE_URL)
VITE_SUPABASE_PROJECT_REF=

# ---------------------------------------------------------------------------
# Local app origin — must match an origin allowed by the staff-* Edge
# Functions (ALLOWED_ORIGINS, set in ../supabase/.env*)
# ---------------------------------------------------------------------------
VITE_APP_ORIGIN=http://localhost:5173
