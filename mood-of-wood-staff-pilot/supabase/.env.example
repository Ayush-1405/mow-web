# Mood of Wood — Staff Pilot — backend (Supabase Edge Functions)
#
# These are Supabase Edge Function secrets, not Vite env vars — the Vite
# app in ../frontend/ never reads this file. They are set on the Supabase
# project itself:
#   supabase secrets set KEY=value --project-ref bykmyttaesuyjwvtnxks
# (Or: Supabase Dashboard -> Edge Functions -> Secrets.)
#
# For local `supabase functions serve`, copy this file to .env.local and
# fill in real values; .env.local is gitignored.
#
# Auto-injected by the Supabase Edge Runtime — do not set these manually,
# do not put them in `supabase secrets set` or this file:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Required before deploying — see ../frontend/.env.production for why
# ---------------------------------------------------------------------------
# Comma-separated exact origins allowed to call these functions from a
# browser (staff-login and friends read this via _shared/cors.ts).
ALLOWED_ORIGINS=

# Domain used to build the synthetic internal Auth email for staff-create-user.
STAFF_INTERNAL_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Optional — safe defaults if omitted
# ---------------------------------------------------------------------------
# Download signed-URL lifetime in seconds (staff-file-url only).
STAFF_SIGNED_URL_TTL_SECONDS=120

# Storage bucket name (staff-file-url only). Defaults to "staff-attachments",
# matching the bucket created in supabase/migrations/mvp_pilot_storage_policies_v2_1a.sql.
STAFF_ATTACHMENTS_BUCKET=staff-attachments
